<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>30-Slide HTML Presentation Template</title>
    <style>
        :root {
            --bg-color: #0f172a;
            --text-color: #f8fafc;
            --accent-color: #3b82f6;
            --accent-glow: rgba(59, 130, 246, 0.5);
            --slide-bg: #1e293b;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
        }

        #deck-container {
            position: relative;
            width: 85vw;
            max-width: 1200px;
            height: 75vh;
            max-height: 800px;
            background-color: var(--slide-bg);
            border-radius: 16px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
            overflow: hidden;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .slide {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            padding: 4rem 5rem;
            opacity: 0;
            visibility: hidden;
            transform: translateY(20px);
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .slide.active {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* Slide Layouts */
        .title-slide {
            text-align: center;
            align-items: center;
        }

        h1 {
            font-size: 4rem;
            margin-bottom: 1rem;
            background: linear-gradient(to right, #60a5fa, #a78bfa);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        h2 {
            font-size: 2.5rem;
            margin-bottom: 1.5rem;
            color: #e2e8f0;
            border-bottom: 3px solid var(--accent-color);
            padding-bottom: 0.5rem;
            display: inline-block;
        }

        p {
            font-size: 1.5rem;
            line-height: 1.6;
            color: #cbd5e1;
            margin-bottom: 1rem;
        }

        ul {
            font-size: 1.5rem;
            line-height: 1.8;
            color: #cbd5e1;
            padding-left: 2rem;
        }

        li {
            margin-bottom: 0.75rem;
        }

        .two-column {
            display: flex;
            gap: 3rem;
            margin-top: 2rem;
            flex: 1;
        }

        .col {
            flex: 1;
        }

        .quote {
            font-size: 2.5rem;
            font-style: italic;
            text-align: center;
            color: #93c5fd;
            border-left: none;
            padding: 2rem;
            background: rgba(59, 130, 246, 0.1);
            border-radius: 12px;
        }

        /* Controls */
        #controls {
            position: absolute;
            bottom: 2rem;
            right: 2rem;
            display: flex;
            gap: 1rem;
            z-index: 100;
        }

        button {
            background-color: transparent;
            color: var(--text-color);
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 0.75rem 1.5rem;
            font-size: 1rem;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        button:hover {
            background-color: var(--accent-color);
            border-color: var(--accent-color);
            box-shadow: 0 0 15px var(--accent-glow);
        }

        /* Progress Bar */
        #progress-container {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 6px;
            background-color: #334155;
        }

        #progress-bar {
            height: 100%;
            background-color: var(--accent-color);
            width: 0%;
            transition: width 0.3s ease;
            box-shadow: 0 0 10px var(--accent-glow);
        }

        #slide-counter {
            position: absolute;
            bottom: 2.5rem;
            left: 2.5rem;
            font-size: 1.1rem;
            color: #94a3b8;
        }
    </style>
</head>
<body>

    <div id="deck-container">
        
        <!-- Slide 1 -->
